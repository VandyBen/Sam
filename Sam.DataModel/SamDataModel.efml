  <method name="SpApplicationSearch" p1:procedure="dbo.spApplicationSearch" p1:Guid="eac99234-446e-4bfc-9e9f-4b60927fc2a4">
    <return class="Application" />
    <parameter name="ListId" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="PsAdmApplNbr" type="String" sql-type="varchar" length="16" />
    <parameter name="Career" type="String" sql-type="varchar" length="16" />
    <parameter name="RoundKey" type="String" sql-type="varchar" length="16" />
    <parameter name="AdmitType" type="String" sql-type="varchar" length="32" />
    <parameter name="ApplicationAdmitTerm" type="String" sql-type="varchar" length="16" />
    <parameter name="SatAdmissionsScore" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="TestType" type="String" sql-type="varchar" length="16" />
    <parameter name="TestUpdate" type="DateTime" sql-type="datetime" />
    <parameter name="SatHighestVerifiedMaxCriticalReading" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="SatHighestVerifiedMaxMath" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="SatrAdmissionsScore" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="ActHighestVerifiedTotalEnglish" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="ActHighestVerifiedTotalMath" type="Int32" sql-type="int" precision="10" scale="0" />
    <parameter name="RIC" type="Decimal" sql-type="decimal" precision="10" scale="7" />
    <parameter name="ERIC" type="Decimal" sql-type="decimal" precision="10" scale="7" />
    <parameter name="DecisionUpdate" type="DateTime" sql-type="datetime" />
    <parameter name="DecisionConfirmedExport3Code" type="String" sql-type="varchar" length="16" />
    <parameter name="DecisionConfirmedCode" type="String" sql-type="varchar" length="16" />
    <parameter name="DecisionConfirmedReasonExportKey" type="String" sql-type="varchar" length="16" />
    <parameter name="SchoolUpdate" type="DateTime" sql-type="datetime" />
    <parameter name="HsgpaCalculated" type="Decimal" sql-type="decimal" precision="10" scale="7" />
    <parameter name="EvaluationStatus" type="String" sql-type="varchar" length="16" />
    <parameter name="EvalStatusDescr" type="String" sql-type="varchar" length="64" />
